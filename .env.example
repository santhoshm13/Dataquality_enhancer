# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to backend/.env for local development.
# In production (Render), set these in the dashboard — never commit real values.

PORT=8000
HOST=0.0.0.0
ENV=development

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# Production: set to your Supabase connection string in Render dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase Credentials (Optional REST / Storage integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# LLM Configuration
# Options: mock | gemini | openai
# Production: set to gemini and add GEMINI_API_KEY in Render dashboard
LLM_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# CORS Configuration
# Comma-separated list of allowed frontend origins
# Include your local dev URL and your deployed Vercel URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-project.vercel.app

# Scraping (Optional)
# Get a free key at https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=your-firecrawl-api-key
