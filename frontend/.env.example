# ============================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local (gitignored) and fill in the values.
# All VITE_* variables are embedded at BUILD time by Vite — they are
# NOT secret. Do not put private keys or service-role keys here.

# ------------------------------------------------------------------
# Required: URL of the deployed backend (Render, Railway, etc.)
# In Vercel project settings → Environment Variables, set:
#   VITE_API_URL = https://your-backend-name.onrender.com/api
#
# Leave blank for local development — the app defaults to
# http://127.0.0.1:8000/api when running on localhost.
# ------------------------------------------------------------------
VITE_API_URL=https://your-backend-name.onrender.com/api

# ------------------------------------------------------------------
# Optional: Supabase (only needed if using Supabase client directly
# in the frontend — e.g., for auth or realtime subscriptions).
# Your anon key is safe to expose publicly; it is NOT a secret key.
# ------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
